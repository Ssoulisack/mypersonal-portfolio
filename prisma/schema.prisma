model Work {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  url       String?  @db.VarChar(255)
  colorCode String?  @db.VarChar(255)

  translations WorkTranslation[]

  @@map("works")
}

model WorkTranslation {
  id          Int     @id @default(autoincrement())
  workId      Int
  locale      String  @db.VarChar(10) // "en", "lo", "th"
  title       String  @db.VarChar
  description String
  content     String?
  outcome     String?
  keyFeatures Json?   @default("[]")
  techStack   Json?   @default("[]")
  challenges  Json?   @default("[]")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId])
  @@index([locale, workId])
  @@map("work_translations")
}

model TocItem {
  id    Int     @id @default(autoincrement())
  label String  @db.VarChar(255)
  href  String  @db.VarChar(255)
  level Int     @default(0) // 0 for top level, 1 for nested
  icon  String? @db.VarChar(10) // Optional emoji
  order Int     @default(0) // Sort order

  @@map("toc_items")
}

model TimelineItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  date                 String                @db.VarChar
  badge                String
  image                String?
  timeLineTranslations TimeLineTranslation[]

  @@map("timeline_items")
}

model TimeLineTranslation {
  id             Int    @id @default(autoincrement())
  timelineItemId Int
  locale         String @db.VarChar
  title          String @db.VarChar
  description    String @db.VarChar

  timelineItem TimelineItem @relation(fields: [timelineItemId], references: [id], onDelete: Cascade)

  @@index([locale, timelineItemId])
  @@map("timeline_translations")
}

model PersonalInfo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email                    String                    @db.VarChar(255)
  phone                    String                    @db.VarChar(255)
  position                 String?                   @db.VarChar(255)
  avatar                   String?                   @db.VarChar(255)
  personalInfoTranslations PersonalInfoTranslation[]
  socials                  Social[]

  @@map("personal_infos")
}

model PersonalInfoTranslation {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  personalInfoId Int
  locale         String   @db.VarChar(10)
  name           String   @db.VarChar(255)
  bio            String?  @db.VarChar(255)
  address        String?  @db.VarChar(255)

  personalInfo PersonalInfo @relation(fields: [personalInfoId], references: [id], onDelete: Cascade)

  @@map("personal_info_translations")
}

model Social {
  id             Int    @id @default(autoincrement())
  username       String @db.VarChar(50)
  platform       String @db.VarChar(50)
  url            String @db.VarChar(255)
  icon           String @db.VarChar(255)
  personalInfoId Int?

  personalInfo PersonalInfo? @relation(fields: [personalInfoId], references: [id], onDelete: Cascade)

  @@unique([platform])
  @@map("socials")
}

model Card {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title     String @db.VarChar(255)
  image     String @db.VarChar(255)
  className String @db.VarChar(255)

  @@map("cards")
}
